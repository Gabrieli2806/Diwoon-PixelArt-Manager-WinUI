<Page
    x:Class="DiwoonPixelArtManager.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,24">
        <StackPanel Spacing="12" HorizontalAlignment="Stretch">

            <TextBlock Text="Device" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Connect your Divoom display over Bluetooth or Wi-Fi and choose what it shows"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <!-- Connection -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE702;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="CONNECTION" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE7F4;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Display" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="ConnectionText" Style="{StaticResource CardDescription}"
                                       Text="Bluetooth displays: pair them in Windows settings first. Wi-Fi displays (Pixoo-64): press Scan or type their IP." />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceCombo" HorizontalAlignment="Stretch" PlaceholderText="No Divoom device found" />
                        <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource Action}" Click="Scan_Click"
                                ToolTipService.ToolTip="Search for Bluetooth displays nearby and Wi-Fi displays on this network (about 10 seconds)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ConnectButton" Grid.Column="2" Style="{StaticResource PrimaryAction}" MinWidth="120"
                                Click="Connect_Click" Content="Connect" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WifiAddressBox" PlaceholderText="Wi-Fi display IP address, for example 192.168.1.50" />
                        <Button x:Name="AddWifiButton" Grid.Column="1" Style="{StaticResource Action}" MinWidth="120"
                                Content="Add" Click="AddWifi_Click" />
                    </Grid>
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />
                    <InfoBar x:Name="ConnectionMessage" IsOpen="False" Severity="Error" />
                </StackPanel>
            </Border>

            <ContentControl x:Name="ControlsHost" IsEnabled="False"
                            HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">

                    <!-- Display -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                        <FontIcon Glyph="&#xE706;" Style="{StaticResource SectionIcon}" />
                        <TextBlock Grid.Column="1" Text="DISPLAY" Style="{StaticResource SectionHeader}" />
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE706;" Style="{StaticResource CardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Brightness" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Screen brightness from 0 to 100" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                            <Slider x:Name="BrightnessSlider" Grid.Column="2" Width="220" Minimum="0" Maximum="100"
                                    Value="80" StepFrequency="1" VerticalAlignment="Center" ValueChanged="Brightness_ValueChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE7E8;" Style="{StaticResource CardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Screen" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Turn the LEDs off without disconnecting" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource Action}" Content="Turn off" Click="ScreenOff_Click" />
                                <Button Style="{StaticResource Action}" Content="Turn on" Click="ScreenOn_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Channels -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                        <FontIcon Glyph="&#xE8A9;" Style="{StaticResource SectionIcon}" />
                        <TextBlock Grid.Column="1" Text="CHANNELS" Style="{StaticResource SectionHeader}" />
                    </Grid>

                    <StackPanel x:Name="BluetoothChannels" Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xE823;" Style="{StaticResource CardIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Clock" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Show the time with the chosen style and color" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="ClockStyleCombo" Width="170" SelectedIndex="0">
                                        <ComboBoxItem Content="Full screen" />
                                        <ComboBoxItem Content="Rainbow" />
                                        <ComboBoxItem Content="With box" />
                                        <ComboBoxItem Content="Analog square" />
                                        <ComboBoxItem Content="Full screen negative" />
                                        <ComboBoxItem Content="Analog round" />
                                    </ComboBox>
                                    <DropDownButton x:Name="ClockColorButton" ToolTipService.ToolTip="Clock color">
                                        <Border x:Name="ClockColorSwatch" Width="20" Height="16" CornerRadius="3" Background="White" />
                                        <DropDownButton.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="ClockColorPicker" Color="White" IsAlphaEnabled="False"
                                                             ColorChanged="ClockColor_Changed" />
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button Style="{StaticResource Action}" Content="Show" Click="Clock_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xEA80;" Style="{StaticResource CardIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Light" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Use the display as a lamp" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="LightEffectCombo" Width="170" SelectedIndex="0">
                                        <ComboBoxItem Content="Plain color" />
                                        <ComboBoxItem Content="Love" />
                                        <ComboBoxItem Content="Plants" />
                                        <ComboBoxItem Content="No mosquito" />
                                        <ComboBoxItem Content="Sleeping" />
                                    </ComboBox>
                                    <DropDownButton ToolTipService.ToolTip="Light color">
                                        <Border x:Name="LightColorSwatch" Width="20" Height="16" CornerRadius="3" Background="#7C4DFF" />
                                        <DropDownButton.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="LightColorPicker" Color="#7C4DFF" IsAlphaEnabled="False"
                                                             ColorChanged="LightColor_Changed" />
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button Style="{StaticResource Action}" Content="Show" Click="Light_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xE945;" Style="{StaticResource CardIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="VJ effects" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Built-in animated effects" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="VjCombo" Width="170" />
                                    <Button Style="{StaticResource Action}" Content="Show" Click="Vj_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xE93C;" Style="{StaticResource CardIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Visualizer" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Reacts to the sound picked up by the display" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="VisualizerCombo" Width="170" />
                                    <Button Style="{StaticResource Action}" Content="Show" Click="Visualizer_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xE8B9;" Style="{StaticResource CardIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Gallery channels" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Your last custom animation, or the Divoom cloud gallery" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource Action}" Content="Custom" Click="Custom_Click" />
                                    <Button Style="{StaticResource Action}" Content="Cloud" Click="Cloud_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="WifiChannels" Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xE8A9;" Style="{StaticResource CardIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Channel" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Switch the display to one of its own channels" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="WifiChannelCombo" Width="170" SelectedIndex="0">
                                        <ComboBoxItem Content="Clock faces" />
                                        <ComboBoxItem Content="Cloud gallery" />
                                        <ComboBoxItem Content="Visualizer" />
                                        <ComboBoxItem Content="Custom" />
                                    </ComboBox>
                                    <Button Style="{StaticResource Action}" Content="Show" Click="WifiChannel_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xE823;" Style="{StaticResource CardIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Clock face" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Face number as listed in the Divoom app" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="ClockFaceBox" Width="170" Minimum="0" Maximum="100000" Value="0"
                                               SpinButtonPlacementMode="Compact" />
                                    <Button Style="{StaticResource Action}" Content="Show" Click="ClockFace_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xE93C;" Style="{StaticResource CardIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Visualizer" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Reacts to the sound picked up by the display" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="WifiVisualizerCombo" Width="170" />
                                    <Button Style="{StaticResource Action}" Content="Show" Click="WifiVisualizer_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE9F9;" Style="{StaticResource CardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Scoreboard" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Red and blue scores from 0 to 999" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="RedScoreBox" Header="Red" Width="96" Minimum="0" Maximum="999" Value="0"
                                           SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="BlueScoreBox" Header="Blue" Width="96" Minimum="0" Maximum="999" Value="0"
                                           SpinButtonPlacementMode="Compact" />
                                <Button Style="{StaticResource Action}" Content="Show" VerticalAlignment="Bottom" Click="Scoreboard_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <InfoBar x:Name="CommandMessage" IsOpen="False" Severity="Error" />
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
