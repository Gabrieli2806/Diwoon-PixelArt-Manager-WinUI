<Page
    x:Class="DiwoonPixelArtManager.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DiwoonPixelArtManager.Models"
    NavigationCacheMode="Required"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Grid Padding="36,24,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Library -->
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Button x:Name="BackButton" Style="{StaticResource Action}" Padding="10,8" VerticalAlignment="Center"
                        Visibility="Collapsed" Click="Back_Click" ToolTipService.ToolTip="Back to all folders">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Grid.Column="1">
                    <BreadcrumbBar x:Name="Breadcrumb" ItemClicked="Breadcrumb_ItemClicked">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource TitleTextBlockStyle}" />
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                    <TextBlock x:Name="CountText" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PrimaryAction}" Click="AddFiles_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add images" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Action}" Click="AddFolder_Click"
                        ToolTipService.ToolTip="Adds a folder of images; it appears as a folder in the gallery">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource Action}" IsEnabled="False"
                        Click="Remove_Click" ToolTipService.ToolTip="Remove from the gallery (the files are not deleted)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Remove" />
                    </StackPanel>
                </Button>
                <Button x:Name="SlideshowButton" Grid.Column="3" Style="{StaticResource Action}" Click="Slideshow_Click"
                        ToolTipService.ToolTip="Show the selected images (or everything here) one after another">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="SlideshowIcon" Glyph="&#xE786;" FontSize="14" />
                        <TextBlock x:Name="SlideshowText" Text="Slideshow" />
                    </StackPanel>
                </Button>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="4" MaxWidth="280" HorizontalAlignment="Right"
                                PlaceholderText="Search all images" QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
            </Grid>

            <GridView x:Name="ArtGrid" Grid.Row="2"
                      SelectionMode="Extended"
                      SelectionChanged="ArtGrid_SelectionChanged"
                      DoubleTapped="ArtGrid_DoubleTapped"
                      RightTapped="ArtGrid_RightTapped"
                      ContainerContentChanging="ArtGrid_ContainerContentChanging">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:GalleryEntry">
                        <Grid Width="156" Height="214">
                            <!-- A folder is a card with another card edge peeking out behind it. -->
                            <Border Visibility="{x:Bind StackVisibility}" Margin="8,0,0,8" Style="{StaticResource CardStyle}" Opacity="0.55" />
                            <Border Margin="0,6,8,0" Style="{StaticResource CardStyle}" Padding="10">
                                <StackPanel Spacing="8">
                                    <Grid Width="128" Height="128" CornerRadius="4" Background="{StaticResource LedBackgroundBrush}">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="None" />
                                        <Border Visibility="{x:Bind AnimatedBadgeVisibility}"
                                                Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,1"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                                            <TextBlock Text="GIF" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WhiteBrush}" />
                                        </Border>
                                        <Border Visibility="{x:Bind FolderBadgeVisibility}"
                                                Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource WhiteBrush}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Tooltip}" />
                                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEB9F;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyTitle" Text="Your gallery is empty" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Text="Add images or a folder, or drop them here. Folders stay grouped."
                           Style="{StaticResource CardDescription}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Preview -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,0">
                    <FontIcon Glyph="&#xE7B3;" Style="{StaticResource SectionIcon}" />
                    <TextBlock Grid.Column="1" Text="ON THE DISPLAY" Style="{StaticResource SectionHeader}" />
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid Width="256" Height="256" CornerRadius="6" Background="{StaticResource LedBackgroundBrush}" HorizontalAlignment="Center">
                            <Image x:Name="PreviewImage" Stretch="None" />
                            <TextBlock x:Name="PreviewHint" Text="Select an image or a folder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#80FFFFFF" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock x:Name="PreviewName" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewDetails" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <Button x:Name="SendButton" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Stretch"
                                IsEnabled="False" Click="Send_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="14" />
                                <TextBlock x:Name="SendText" Text="Send to display" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditButton" Style="{StaticResource Action}" HorizontalAlignment="Stretch"
                                IsEnabled="False" Click="Edit_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="EditIcon" Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock x:Name="EditText" Text="Edit a copy" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RenameButton" Style="{StaticResource Action}" HorizontalAlignment="Stretch"
                                Visibility="Collapsed" Click="Rename_Click"
                                ToolTipService.ToolTip="Changes the name shown in this app; the folder on disk keeps its name">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                                <TextBlock Text="Rename folder" />
                            </StackPanel>
                        </Button>
                        <ProgressBar x:Name="SendProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="Message" IsOpen="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
