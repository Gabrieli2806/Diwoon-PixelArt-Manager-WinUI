<Page
    x:Class="DiwoonPixelArtManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,24">
        <StackPanel Spacing="12" HorizontalAlignment="Stretch">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Configure Diwoon PixelArt Manager"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <!-- Appearance -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE790;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="APPEARANCE" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE771;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Light, dark or the Windows setting" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="180" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="Use system setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Window effect" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Visual backdrop style" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="BackdropCombo" Grid.Column="2" Width="180" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Image conversion -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE7B3;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="IMAGE CONVERSION" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Display size" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Detected from the device name; change it if your model is detected wrong"
                                   Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="SizeCombo" Grid.Column="2" Width="180" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="Automatic" Tag="0" />
                        <ComboBoxItem Content="16 × 16" Tag="16" />
                        <ComboBoxItem Content="32 × 32" Tag="32" />
                        <ComboBoxItem Content="64 × 64" Tag="64" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE740;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Scaling" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Pixel keeps hard edges (best for pixel art); Smooth blends colors (best for photos)"
                                   Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="ScalingCombo" Grid.Column="2" Width="180" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="Pixel" Tag="Pixel" />
                        <ComboBoxItem Content="Smooth" Tag="Smooth" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE9A6;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Non-square images" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Fit adds black bars, Fill crops the edges, Stretch distorts"
                                   Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="FitCombo" Grid.Column="2" Width="180" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="Fit" Tag="Fit" />
                        <ComboBoxItem Content="Fill" Tag="Fill" />
                        <ComboBoxItem Content="Stretch" Tag="Stretch" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE786;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Slideshow" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Seconds each image stays, and whether the order is shuffled" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <NumberBox x:Name="SlideshowBox" Grid.Column="2" Width="110" Minimum="3" Maximum="3600"
                               SpinButtonPlacementMode="Compact" ValueChanged="Slideshow_ValueChanged" />
                    <ToggleSwitch x:Name="ShuffleToggle" Grid.Column="3" OnContent="Shuffle" OffContent="In order" Toggled="Toggle_Changed" />
                </Grid>
            </Border>

            <!-- Startup -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="STARTUP AND BACKGROUND" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE7B5;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Starts hidden in the notification area when you sign in" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" Toggled="Startup_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE73F;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Keep running when closed" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Closing the window leaves the app in the notification area so slideshows, the PC monitor and alerts continue. Exit from the tray icon."
                                   Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TrayToggle" Grid.Column="2" Toggled="Toggle_Changed" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE71B;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Connect automatically" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Connect to the last display at start, and reconnect when the connection drops"
                                   Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoConnectToggle" Grid.Column="2" Toggled="Toggle_Changed" />
                </Grid>
            </Border>

            <!-- HTTP API -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE968;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="HTTP API" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE774;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Local web server" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Lets scripts on this PC send images and commands. Only reachable from this computer."
                                       Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="BridgeToggle" Grid.Column="2" Toggled="Bridge_Toggled" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE71B;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Port" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="BridgeStatusText" Style="{StaticResource CardDescription}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <NumberBox x:Name="PortBox" Grid.Column="2" Width="180" Minimum="1024" Maximum="65535"
                                   SpinButtonPlacementMode="Compact" ValueChanged="Port_ValueChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE946;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="ABOUT" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="ms-appx:///Assets/AppLogo.png" Width="32" Height="32" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}">
                            <Run Text="Made by Gabrieli2806 · " />
                            <Hyperlink NavigateUri="https://discord.gg/DhBbAzugZ9">Discord</Hyperlink>
                            <Run Text=" · Based on iebb/Diwoom (Apache-2.0)" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
