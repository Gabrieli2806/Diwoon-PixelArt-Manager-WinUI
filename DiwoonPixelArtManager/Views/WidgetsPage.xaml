<Page
    x:Class="DiwoonPixelArtManager.Views.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,24">
        <StackPanel Spacing="12">

            <TextBlock Text="Widgets" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Live screens for the display: AI agents, the music playing on this PC and a timer"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <!-- AI agents -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE99A;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="AI AGENTS" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <Grid Width="192" Height="192" CornerRadius="6" Background="{StaticResource LedBackgroundBrush}">
                            <Image x:Name="AgentPreview" Stretch="None" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <Button Content="Needs you" Click="TestWaiting_Click" ToolTipService.ToolTip="Play this animation on the display" />
                            <Button Content="Done" Click="TestDone_Click" ToolTipService.ToolTip="Play this animation on the display" />
                            <Button Content="Error" Click="TestError_Click" ToolTipService.ToolTip="Play this animation on the display" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="14">
                        <StackPanel>
                            <TextBlock Text="Claude Code, Codex and Antigravity (Gemini)" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Works in VS Code, the terminal or the desktop apps: the app reads their conversation logs (never writes to them). A question or permission request stays on the display until you answer; finished turns and errors play once." />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Show AI agents on the display" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="AgentsToggle" Grid.Column="1" Toggled="AgentSetting_Toggled" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="AgentWaitingCheck" Content="Needs an answer" Click="AgentSetting_Toggled" />
                            <CheckBox x:Name="AgentDoneCheck" Content="Finished" Click="AgentSetting_Toggled" />
                            <CheckBox x:Name="AgentErrorCheck" Content="Error" Click="AgentSetting_Toggled" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="ClaudeCheck" Content="Claude Code" Click="AgentSetting_Toggled" />
                            <CheckBox x:Name="CodexCheck" Content="Codex" Click="AgentSetting_Toggled" />
                            <CheckBox x:Name="AntigravityCheck" Content="Antigravity" Click="AgentSetting_Toggled" />
                        </StackPanel>
                        <StackPanel x:Name="AgentList" Spacing="4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Now playing -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE8D6;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="NOW PLAYING" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="192" Height="192" CornerRadius="6" Background="{StaticResource LedBackgroundBrush}">
                        <Image x:Name="MusicPreview" Stretch="None" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="TrackTitle" Text="Nothing playing" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TrackArtist" Style="{StaticResource CardDescription}"
                                       Text="Play something in Spotify, a browser or any player that shows in the Windows volume panel." />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Text="Show on the display" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Cover art with a progress bar; the title too on 32 and 64 LED displays" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="MusicToggle" Grid.Column="1" Toggled="MusicToggle_Toggled" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Text="Announce new songs" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Scrolls the artist and title when the track changes" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AnnounceToggle" Grid.Column="1" Toggled="Announce_Toggled" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Timer -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE916;" Style="{StaticResource SectionIcon}" />
                <TextBlock Grid.Column="1" Text="TIMER AND POMODORO" Style="{StaticResource SectionHeader}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="192" Height="192" CornerRadius="6" Background="{StaticResource LedBackgroundBrush}">
                        <Image x:Name="TimerPreview" Stretch="None" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="TimerText" Text="00:00" Style="{StaticResource TitleTextBlockStyle}" FontFamily="Consolas" />
                            <TextBlock x:Name="TimerPhaseText" Text="Not running" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox x:Name="TimerMinutesBox" Header="Timer (min)" Width="120" Minimum="1" Maximum="600"
                                       SpinButtonPlacementMode="Compact" ValueChanged="Minutes_ValueChanged" />
                            <NumberBox x:Name="FocusBox" Header="Focus (min)" Width="120" Minimum="1" Maximum="180"
                                       SpinButtonPlacementMode="Compact" ValueChanged="Minutes_ValueChanged" />
                            <NumberBox x:Name="BreakBox" Header="Break (min)" Width="120" Minimum="1" Maximum="60"
                                       SpinButtonPlacementMode="Compact" ValueChanged="Minutes_ValueChanged" />
                            <NumberBox x:Name="LongBreakBox" Header="Long break (min)" Width="140" Minimum="1" Maximum="120"
                                       SpinButtonPlacementMode="Compact" ValueChanged="Minutes_ValueChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource PrimaryAction}" Content="Start timer" Click="StartTimer_Click" />
                            <Button Style="{StaticResource PrimaryAction}" Content="Start Pomodoro" Click="StartPomodoro_Click" />
                            <Button x:Name="PauseButton" Style="{StaticResource Action}" Content="Pause" Click="Pause_Click" />
                            <Button x:Name="SkipButton" Style="{StaticResource Action}" Content="Skip phase" Click="Skip_Click" />
                            <Button x:Name="StopButton" Style="{StaticResource Action}" Content="Stop" Click="Stop_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="Message" IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
